# Copy to .env and fill in real values. Never commit .env.

# Polymarket API
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_API_BASE=https://api.polymarket.com

# Live trading opt-in (default is paper-only)
SYSTEMIC_ARBITRAGE_LIVE=0

# Optional: proxy for pytrends if rate-limited
# PYTRENDS_PROXY=http://localhost:8080
